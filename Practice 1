Задача 8
Написать программу, которая находит все файлы в данном каталоге с расширением, указанным в качестве аргумента и архивирует все эти файлы в архив tar. Код файла eight, созданного в консоли:

#!/bin/bash
if [ $# -ne 2 ]; then
    echo "Usage: $0 <dir> <extension>" >&2
    exit 1
fi

dir="$1"
ext="$2"

find "$dir" -maxdepth 1 -type f -name "*.$ext" -print0 | tar --null -T - -cf "archive_$ext.tar"
